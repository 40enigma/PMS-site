# ==============================================================================
# PIEAS Materials Society (PMS) — Production Environment Template (.env.production.example)
# Copy this file to .env and adjust values for your production environment.
# NEVER commit .env to version control.
# ==============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000

# Must be "production" for production deployments.
RUST_ENV=production

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite://pms.db?mode=rwc

# ── Security: JWT ───────────────────────────────────────────────────────────
# REQUIRED in production. Generate via: openssl rand -hex 32
# Server will EXIT on startup if unset, shorter than 32 chars, or containing
# "replace-with" or "placeholder".
JWT_SECRET=

# Name of the httpOnly cookie used to store the access token (default: pms_admin_token)
JWT_COOKIE_NAME=pms_admin_token

# Always true in production when serving over HTTPS.
JWT_COOKIE_SECURE=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. REQUIRED in production.
ALLOWED_ORIGINS=https://pms.pieas.edu.pk,https://www.pms.pieas.edu.pk

# ── Data & Admin Seeding ────────────────────────────────────────────────────
# In production, seed data should be false to prevent demo records.
SEED_DATA=false

# Set SEED_ADMIN=true ONLY on initial first boot to create the root admin account.
# Immediately change SEED_ADMIN back to false after first boot.
SEED_ADMIN=false
ADMIN_INITIAL_EMAIL=admin@pms.pieas.edu.pk
# Set a strong, unique admin password (min 12 chars).
# ADMIN_INITIAL_PASSWORD=

# ── Rate Limiting & Reverse Proxy ────────────────────────────────────────────
RATE_LIMIT_LOGIN_RPM=10
RATE_LIMIT_SUBMIT_RPM=30
RATE_LIMIT_REGISTER_RPM=60
RATE_LIMIT_CONTACT_RPM=10
RATE_LIMIT_NEWSLETTER_RPM=10
RATE_LIMIT_MEMBERSHIP_RPM=15
RATE_LIMIT_CERT_VERIFY_RPM=60

# Set to true when running behind Nginx, Caddy, or another reverse proxy.
# At startup in production, a warning will be logged if TRUST_PROXY is unset.
TRUST_PROXY=true

# Set to true ONLY if PMS is directly fronted by Cloudflare.
TRUST_CLOUDFLARE=false

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

