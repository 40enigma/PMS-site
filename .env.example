# ==============================================================================
# PIEAS Materials Society (PMS) — Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000

# Set to "production" or "development". Affects startup validation strictness.
RUST_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite://pms.db?mode=rwc

# ── Security: JWT ───────────────────────────────────────────────────────────
# REQUIRED in production. Generate via: openssl rand -hex 32
# Server will EXIT on startup if unset, shorter than 32 chars, or containing
# "replace-with" or "placeholder" when RUST_ENV=production.
# JWT_SECRET=

# Name of the httpOnly cookie used to store the access token (default: pms_admin_token)
JWT_COOKIE_NAME=pms_admin_token

# Whether to set Secure flag on the auth cookie.
# Defaults to true in production, false in development.
# Set to "false" explicitly when testing locally over HTTP.
JWT_COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# REQUIRED in production. Server will EXIT on startup if unset in production.
# Example: ALLOWED_ORIGINS=https://pms.pieas.edu.pk,https://www.pms.pieas.edu.pk
# Development: leave unset or set to local origin.
ALLOWED_ORIGINS=http://localhost:3000

# ── Data & Admin Seeding ────────────────────────────────────────────────────
# Set SEED_DATA=true to populate initial demo data (events, articles, team members).
# Defaults to false in production, true in development if unset.
SEED_DATA=false

# Set SEED_ADMIN=true ONLY for the initial first-run to create an admin user.
# Remove or set to "false" after first use. Requires explicit credentials below.
# Without this flag, NO admin user is ever created automatically.
SEED_ADMIN=false
ADMIN_INITIAL_EMAIL=admin@pms.pieas.edu.pk
# Set a strong admin password when SEED_ADMIN=true. Do not commit real passwords.
# ADMIN_INITIAL_PASSWORD=

# ── Rate Limiting & Reverse Proxy ────────────────────────────────────────────
# Admin session lifetime in seconds (default: 86400 = 24h, min 300, max 604800)
JWT_TTL_SECONDS=86400

# Requests per minute per IP for login endpoint (default: 10)
RATE_LIMIT_LOGIN_RPM=10
# Requests per minute per IP for submit endpoints (default: 30)
RATE_LIMIT_SUBMIT_RPM=30
# Requests per minute per IP for event registration (default: 60)
RATE_LIMIT_REGISTER_RPM=60
# Requests per minute per IP for contact messages (default: 10)
RATE_LIMIT_CONTACT_RPM=10
# Requests per minute per IP for newsletter subscriptions (default: 10)
RATE_LIMIT_NEWSLETTER_RPM=10
# Requests per minute per IP for membership applications (default: 15)
RATE_LIMIT_MEMBERSHIP_RPM=15
# Requests per minute per IP for certificate verification (default: 60)
RATE_LIMIT_CERT_VERIFY_RPM=60

# ── Tuning ───────────────────────────────────────────────────────────────────
# SQLite connection pool size (default: 5)
DB_MAX_CONNECTIONS=5
# How long SQLite waits for a write lock, in milliseconds (default: 5000)
DB_BUSY_TIMEOUT_MS=5000
# Upload size cap in megabytes (default: 20)
MAX_UPLOAD_MB=20

# Set to "true" ONLY when running behind a trusted reverse proxy (e.g. Nginx, Caddy).
# When true, the rate limiter uses X-Real-IP first, then the rightmost X-Forwarded-For hop.
# When false (default), proxy headers are strictly ignored to prevent client IP spoofing.
TRUST_PROXY=false

# Set to "true" ONLY when PMS is directly behind Cloudflare.
# Requires TRUST_PROXY=true. Inspects CF-Connecting-IP / True-Client-IP.
TRUST_CLOUDFLARE=false

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory where uploaded media files are saved locally.
UPLOAD_DIR=uploads
