# ==============================================================================
# PIEAS Materials Society (PMS) — Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000

# Set to "production" or "development". Affects startup validation strictness.
RUST_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite://pms.db?mode=rwc

# ── Security: JWT ───────────────────────────────────────────────────────────
# REQUIRED in production. Generate via: openssl rand -hex 32
# Server will EXIT on startup if this is unset in production mode.
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production

# Name of the httpOnly cookie used to store the access token (default: pms_admin_token)
JWT_COOKIE_NAME=pms_admin_token

# Whether to set Secure flag on the auth cookie.
# Defaults to true in production, false in development.
# Set to "false" explicitly when testing locally over HTTP.
JWT_COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# REQUIRED in production. Server will EXIT on startup if unset in production.
# Example: ALLOWED_ORIGINS=https://pms.pieas.edu.pk,https://www.pms.pieas.edu.pk
# Development: leave unset to allow localhost origins automatically.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Admin Seeding ────────────────────────────────────────────────────────────
# Set SEED_ADMIN=true ONLY for the initial first-run to create an admin user.
# Remove or set to "false" after first use. Requires explicit credentials below.
# Without this flag, NO admin user is ever created automatically.
SEED_ADMIN=false
ADMIN_INITIAL_EMAIL=admin@pms.pieas.edu.pk
ADMIN_INITIAL_PASSWORD=ChangeMeStrongPassword2026!

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP for login endpoint (default: 10)
RATE_LIMIT_LOGIN_RPM=10
# Requests per minute per IP for submit endpoints (default: 30)
RATE_LIMIT_SUBMIT_RPM=30

# ── Storage ──────────────────────────────────────────────────────────────────
# In production, consider serving uploads from an object store (S3, etc.)
# rather than the filesystem. The backend stores files locally by default.
UPLOAD_DIR=uploads
